# Never copy host build output or dependencies into the image build context.
**/node_modules
**/dist
# TypeScript incremental cache: if a stale one is copied in, tsc skips emitting
# dist inside the image (produces a broken build). Keep it out.
**/*.tsbuildinfo
.git
.github
**/coverage
**/*.log

# Local env / secrets must never enter an image.
**/.env
**/.env.*

# Docs and infra not needed by either image. NOTE: both the API and the web
# Dockerfiles build from the repo root with this single .dockerignore, so do
# NOT exclude apps/* here — excluding apps/web breaks the web build's
# `COPY apps/web` (the file each image doesn't need is simply never COPY'd).
docs
infra
