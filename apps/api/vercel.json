{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run build --workspace @hsdg/contracts && npm run build --workspace @hsdg/api && SETUP_ONLY=true node scripts/deploy/start.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/v1/internal/cron", "schedule": "30 1 * * *" }]
}
