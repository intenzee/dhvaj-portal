# ── HSDG API environment ──────────────────────────────────────────────────
# Copy to .env for local development:  cp env.example .env
# NEVER commit a real .env. In production these values come from the
# environment / Azure Key Vault, not from a file.

NODE_ENV=development

# HTTP
PORT=3001
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Database — the API connects as the LEAST-PRIVILEGE app role (hsdg_app),
# never the owner/superuser. Passwords below match infra/docker/postgres/init.
# Host port 5433 matches docker-compose (avoids clashing with local Postgres).
DATABASE_URL=postgres://hsdg_app:hsdg_app_dev_pw@localhost:5433/hsdg

# Migrations run as the schema-owning migrator role (npm run db:migrate).
# This is NEVER used by the running API.
DATABASE_MIGRATE_URL=postgres://hsdg_migrator:hsdg_migrator_dev_pw@localhost:5433/hsdg
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# OpenAPI
SWAGGER_ENABLED=true

# Authentication
AUTH_PROVIDER=dev
# Dev-provider JWT signing secret (min 16 chars). Use a real secret from Key
# Vault in production; the dev provider is disabled when AUTH_PROVIDER=entra.
AUTH_JWT_SECRET=dev-only-change-me-in-real-environments
AUTH_JWT_ISSUER=hsdg-portal
AUTH_JWT_AUDIENCE=hsdg-portal
AUTH_ACCESS_TTL_SECONDS=3600
# Entra ID (only when AUTH_PROVIDER=entra)
# AUTH_ENTRA_TENANT_ID=
# AUTH_ENTRA_CLIENT_ID=
# Non-production convenience: also accept the seeded dev-token/persona logins
# alongside the active provider (e.g. Entra SSO). Forced off in production.
AUTH_DEV_FALLBACK=false

# ── Document storage (Phase 10) ────────────────────────────────────────────
# Where document bytes live. `local` is a filesystem provider for dev/test;
# `azure_blob` is the production path. PostgreSQL only ever holds metadata.
STORAGE_PROVIDER=local
# Base directory for the local provider (defaults to an OS temp dir if blank).
# STORAGE_LOCAL_DIR=.storage
# Azure Blob (only when STORAGE_PROVIDER=azure_blob; needs @azure/storage-blob)
# STORAGE_AZURE_CONNECTION_STRING=
# STORAGE_AZURE_CONTAINER=hsdg-documents
# Max single uploaded document version, in bytes (default 10 MiB).
DOCUMENT_MAX_BYTES=10485760

# ── Notifications (Phase 11) ───────────────────────────────────────────────
# Enabled delivery channels (comma-separated). `portal` (the in-app row) is
# always on; add email/teams to fan out (stub transports for now).
NOTIFICATION_CHANNELS=portal
# Days ahead the sweep flags an internal SLA / statutory deadline as approaching.
NOTIFICATION_SLA_LEAD_DAYS=3
NOTIFICATION_DEADLINE_LEAD_DAYS=7
